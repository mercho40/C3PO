# Periodic health check, with repair. Driven by c3po-health.timer.
#
# Restarts a dead bridge or a perception unit whose containers have vanished,
# and does NOTHING else. It never touches the co-tenant's stack, and it never
# arms anything: a watchdog that can start motion is not a watchdog.

[Unit]
Description=C3PO stack health check
Documentation=file:///home/unitree/c3po/docs/OPERATIONS.md
After=c3po-bridge.service

[Service]
Type=oneshot
# Root, because repair means `systemctl restart`. The check itself needs
# nothing; the restart is the whole reason this is not a user unit.
User=root
Environment=HOME=/home/unitree
Environment=PATH=/home/unitree/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/unitree/c3po/scripts/robot/c3po_health --repair
# A failing check is information, not a unit failure — otherwise systemd marks
# the timer's service failed every time perception is legitimately down.
SuccessExitStatus=0 1
