#!/usr/bin/env bash
# Start the VR teleop stream.
#
# Separate from `run_c3po` on purpose. The bridge is infrastructure — it boots
# with the machine and stays up. These two exist to serve a person who is
# currently wearing a headset, so they are started when that person puts it on
# and stopped when they take it off. Leaving a teleop socket listening on an
# unattended robot is a standing invitation for something to drive it.
#
# Refuses to start without the bridge, and that is the important check: the
# teleop stream can command the legs, and `stop_everything` lives on the
# bridge's MCP surface. A commander with no reachable e-stop is not a
# configuration this should let you into.

set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=_common.sh
. "$here/_common.sh"

say "Starting VR teleop"

if ! bridge_running; then
    err "the bridge is not running — refusing to start the teleop stream"
    err "it can command the legs, and stop_everything is served by the bridge."
    err "start it first:  run_c3po"
    exit 1
fi

# Someone else's teleop is the same hazard as someone else's bridge: it holds
# DDS, it writes SetVelocity, and every status check here would say "not
# running".
strays="$(stray_teleop_pids)"
if [ -n "$strays" ]; then
    err "a teleop process is already running outside our pidfile (pid: $(echo "$strays" | tr '\n' ' '))"
    err "kill it first:  kill $(echo "$strays" | tr '\n' ' ')"
    exit 1
fi

if sidecar_pid "$TELEOP_PID" >/dev/null 2>&1; then
    warn "teleop already running (pid $(sidecar_pid "$TELEOP_PID")) — use stop_teleop first"
    exit 0
fi

mkdir -p "$RUN_DIR" "$LOG_DIR"

start_sidecar() {
    local label="$1" module="$2" pidfile="$3" logfile="$4"
    info "starting $label -> $logfile"
    (
        cd "$BRIDGE_DIR"
        set -a
        # shellcheck disable=SC1091
        . ./.env
        set +a
        export PATH="$HOME/.local/bin:$PATH"
        nohup uv run python -m "$module" >>"$logfile" 2>&1 &
        echo $! >"$pidfile"
    )
}

start_sidecar "teleop stream" bridge.teleop.server "$TELEOP_PID" "$TELEOP_LOG"

sleep 2

if sidecar_pid "$TELEOP_PID" >/dev/null 2>&1; then
    ok "teleop stream up (pid $(sidecar_pid "$TELEOP_PID"))"
else
    err "teleop stream failed to start — see $TELEOP_LOG"
    exit 1
fi

# The camera is NOT started here. `apps/perception`'s vision container owns the
# D435i and serves it on 8081; bring it up with `perception_up perception`.
info "camera: run \`perception_up perception\` if you want a picture (port 8081)"

# Show the operator what the robot will and will not do, rather than making
# them read four env vars across two files to find out why the arms are inert.
say "Hardware gates"
sim_mode="$(cd "$BRIDGE_DIR" && set -a && . ./.env && set +a && echo "${SIM_MODE:-stub}")"
if [ "$sim_mode" != "real" ]; then
    # Worth shouting about. In any non-real mode `send_velocity` publishes to
    # `rt/run_command/cmd`, an Isaac Sim convenience channel that real G1
    # firmware does not subscribe to — so everything below reports success and
    # the robot does not move. That reads exactly like a broken headset, a bad
    # tunnel, or a wrong FSM, and it is none of them.
    err "SIM_MODE=$sim_mode — NOT 'real'. Nothing you do will move this robot."
    err "Velocity goes to rt/run_command/cmd, which real firmware ignores."
    err "Fix apps/bridge/.env, then stop_c3po && run_c3po && run_teleop."
else
    ok "SIM_MODE=real"
fi
arm_enabled="$(cd "$BRIDGE_DIR" && set -a && . ./.env && set +a && echo "${TELEOP_ARM_ENABLED:-}")"
hand_enabled="$(cd "$BRIDGE_DIR" && set -a && . ./.env && set +a && echo "${TELEOP_HAND_ENABLED:-}")"
hand_type="$(cd "$BRIDGE_DIR" && set -a && . ./.env && set +a && echo "${TELEOP_HAND_TYPE:-unset}")"

case "$arm_enabled" in
    1|true|yes|on) warn "arms ENABLED (rt/arm_sdk). Joint signs must already be verified — scripts/arm_sign_check.py" ;;
    *)             info "arms disabled. Head yaw and walking still work. Enable with TELEOP_ARM_ENABLED=1 in apps/bridge/.env, after arm_sign_check.py" ;;
esac
case "$hand_enabled" in
    1|true|yes|on) warn "fingers ENABLED, type=$hand_type. Wrong hand type is a different command, not a no-op." ;;
    *)             info "fingers disabled. The hands are two BrainCo ([0,1], and NO firmware deadman — a closed hand stays closed until something opens it)" ;;
esac

say "Reach it from your laptop"
cat <<'TUNNEL'
  ssh -N -o ControlMaster=no \
      -L 8001:127.0.0.1:8001 \
      -L 8081:127.0.0.1:8081 \
      -L 8767:127.0.0.1:8767 c3po

  then open /vr-control in the Quest's browser.
TUNNEL

warn "while a headset session is open, do NOT drive the robot from anywhere else."
warn "nothing at the DDS layer will stop you; the setpoints just interleave."
