#!/usr/bin/env bash
# Stop the VR sidecars. Leaves the bridge alone.
#
# Stopping the stream is not itself a stop command to the robot — but it does
# not need to be. The server's own shutdown path sends a zero-velocity command
# and ramps rt/arm_sdk's blend weight down, and below that the firmware's
# `duration` deadman expires within a second of the last setpoint. Killing the
# process is a safe way to end a session, which is the property you want from
# something an operator reaches for in a hurry.

set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=_common.sh
. "$here/_common.sh"

say "Stopping VR sidecars"

stopped=0
for pair in "teleop stream:$TELEOP_PID:stray_teleop_pids" "camera relay:$RELAY_PID:stray_relay_pids"; do
    label="${pair%%:*}"; rest="${pair#*:}"
    pidfile="${rest%%:*}"; strayfn="${rest##*:}"

    if pid="$(sidecar_pid "$pidfile" 2>/dev/null)"; then
        info "stopping $label (pid $pid)"
        # SIGTERM first: the server's own handler is what sends the stop
        # command and ramps the arm weight down. SIGKILL would skip both.
        kill "$pid" 2>/dev/null || true
        for _ in $(seq 1 25); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.2
        done
        if kill -0 "$pid" 2>/dev/null; then
            warn "$label did not exit on SIGTERM — killing"
            kill -9 "$pid" 2>/dev/null || true
        fi
        rm -f "$pidfile"
        stopped=1
    fi

    # A process outside our pidfile still holds DDS and can still write
    # setpoints, so "no pidfile" is not "nothing running".
    strays="$($strayfn)"
    if [ -n "$strays" ]; then
        warn "$label running outside our pidfile — stopping (pid: $(echo "$strays" | tr '\n' ' '))"
        # shellcheck disable=SC2086
        kill $strays 2>/dev/null || true
        stopped=1
    fi
done

if [ "$stopped" = "1" ]; then
    ok "VR sidecars stopped. The bridge is untouched — stop_c3po if you want that too."
else
    info "nothing was running"
fi
