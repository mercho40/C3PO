#!/usr/bin/env bash
# Ensure the systemd-managed bridge is up. Perception stays separate: this
# command claims no camera or LiDAR, so the co-tenant's stack is left running
# unless C3PO_TAKE_OVER=1 says otherwise (with their OK).

set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=_common.sh
. "$here/_common.sh"

say "Starting C3PO"

[ -d "$BRIDGE_DIR" ] || { err "bridge not found at $BRIDGE_DIR"; exit 1; }
[ -f "$BRIDGE_DIR/.env" ] || {
    err "no $BRIDGE_DIR/.env — refusing to start in an unknown target mode"
    exit 1
}

# Fail structural checks before taking the co-tenant down. A missing unit or a
# manually launched bridge cannot be repaired by stopping gemm.
load_state="$(systemctl show --property=LoadState --value c3po-bridge.service 2>/dev/null || true)"
[ "$load_state" = "loaded" ] || {
    err "c3po-bridge.service is not loaded — run: ./scripts/robot/c3po install"
    exit 1
}

# Refuse a manually launched bridge whether the unit is active or not. Direct
# supervision removes the pidfile race only if systemd is the sole owner.
if bridge_running; then
    main_pid="$(bridge_main_pid)"
    strays="$(bridge_process_pids | grep -vx "$main_pid" || true)"
else
    strays="$(bridge_process_pids)"
fi
if [ -n "$strays" ]; then
    err "a bridge process exists outside c3po-bridge.service: $(echo "$strays" | tr '\n' ' ')"
    err "stop it before using the systemd-managed bridge"
    exit 1
fi

# The other team's stack is THEIRS. This used to stop gemm's containers on every
# start, with no flag and no question — on 2026-10-15 that took gemm-bringup
# down after a reboot while they were using the robot. The bridge claims no
# sensor, and the one thing that genuinely cannot share the robot — a second
# motion commander — is what warn_if_other_commander checks below. So: leave
# gemm alone and say so, unless the operator explicitly takes over.
gemm_now="$(gemm_running)"
if [ -n "$gemm_now" ]; then
    if [ "${C3PO_TAKE_OVER:-0}" = "1" ]; then
        info "gemm is running and C3PO_TAKE_OVER=1 — stopping it"
        "$here/stop_gemm"
    else
        warn "gemm is running ($(echo "$gemm_now" | tr '\n' ' ')) — left alone; the bridge claims no sensor"
        info "to stop it too, only with the other team's OK: C3PO_TAKE_OVER=1 c3po up <profile>"
    fi
fi
warn_if_other_commander || exit 1

if ! bridge_running; then
    # Fail with the fix, not with sudo's "a terminal is required" (2026-10-15,
    # over a non-interactive ssh). The unit is enabled at boot, so needing this
    # at all means it did not come up: say where to look as well.
    if ! sudo -n true 2>/dev/null && ! [ -t 0 ]; then
        err "c3po-bridge.service is not running, and starting it needs sudo's password — no terminal here"
        err "  run with a terminal:  ssh -t <robot> 'cd ~/c3po && ./scripts/robot/c3po up core'"
        err "  why it is down:       journalctl -u c3po-bridge -b --no-pager | tail -50"
        exit 2
    fi
    sudo systemctl start c3po-bridge.service
fi

ready=0
# 45 s: the bridge's own boot (imports, DDS init) on the Jetson, not the venv
# sync — systemctl already waited for that. The loop still ends at once on a
# failed unit or a dead process, so the length only matters when it is slow.
for _ in $(seq 1 90); do
    if ready_pid="$(bridge_http_ready 8001)"; then
        ready=1
        break
    fi
    bridge_running || break
    sleep 0.5
done

if [ "$ready" -ne 1 ]; then
    err "c3po-bridge.service did not become ready on 127.0.0.1:8001"
    err "inspect it with: journalctl -u c3po-bridge -n 50 --no-pager"
    exit 1
fi

ok "bridge active (pid $ready_pid), stop_everything reachable"
info "perception remains off unless explicitly started: c3po perception up <stage>"
