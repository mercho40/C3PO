# Perception containers, as a systemd instance: the STAGE is the instance name.
#
#     systemctl enable --now c3po-perception@nav2-fake
#     systemctl start c3po-perception@nav2       # claims BOTH shared sensors
#
# Templated rather than one unit per stage because the stages are mutually
# exclusive and differ only in what they claim. Encoding that in the instance
# name means `systemctl status c3po-perception@nav2` answers "which stage is
# running" without anybody having to inspect containers.
#
# WHICH STAGE YOU ENABLE IS A SHARING DECISION, NOT A PREFERENCE:
#   fake / nav2-fake   claim NOTHING — gemm keeps the Livox and the RealSense
#   odometry           claims the Livox
#   perception / nav2  claim the Livox AND the RealSense
#
# Enabling `nav2` at boot therefore takes both sensors from the other team on
# every power cycle, including ones nobody intended. Enable `nav2-fake` if you
# want something persistent; start the sensor stages by hand, inside an agreed
# window.
#
# It calls perception_up rather than duplicating the docker flags. Those flags —
# runtime, devices, network, IPC — are load-bearing and live in one file on
# purpose; a unit with its own copy would drift the moment either changed.

[Unit]
Description=C3PO perception (stage %i)
Documentation=file:///home/unitree/c3po/apps/perception/README.md
# Containers need the daemon, and the daemon is slow to come up on this Jetson.
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# NOT a dependency of the bridge, and that is deliberate. The bridge owns
# stop_everything; it must come up and stay up whether or not perception can.
After=c3po-bridge.service

[Service]
# perception_up creates and starts the containers and returns — the work is done
# when it exits, but the unit must stay "active" so ExecStop runs on shutdown.
Type=oneshot
RemainAfterExit=yes
User=unitree
Group=unitree
WorkingDirectory=/home/unitree/c3po
Environment=HOME=/home/unitree
Environment=PATH=/home/unitree/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# perception_up refuses stages that claim shared sensors without an explicit
# acknowledgement. A systemd start is not a person, so the acknowledgement is
# recorded here where whoever enables the unit has to read it.
Environment=C3PO_BUILD_ACK_SHARED=1

ExecStart=/home/unitree/c3po/scripts/robot/perception_up %i
ExecStop=/home/unitree/c3po/scripts/robot/stop_perception

# Image pulls and colcon-built containers can be slow to first-start.
TimeoutStartSec=300
TimeoutStopSec=120

# on-failure only. A clean stop is somebody handing the sensors back, and
# restarting into their window would be exactly wrong.
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
