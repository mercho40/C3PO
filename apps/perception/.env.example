# ~/.c3po/perception.env, on the robot. Not read from this folder.
#
# `perception_up` and `build_perception` (bringup/cli.py: operator_env) read
# ~/.c3po/perception.env on every run. Only the names below are taken from it
# (bringup/spec.py: PERSISTENT_ENV_KEYS); any other name is ignored with a
# warning, so a persisted C3PO_TAKE_OVER=1 or C3PO_VISION_FAKE=1 can never become
# a silent default. A shell export of the same name still wins.
#
# Format: KEY=VALUE per line, `export` and `#` comments allowed, shell quoting
# (quote a value with spaces). A malformed line refuses the run and names it.
#
# Everything here is commented out at the code's own default, so copying this
# file as it is changes nothing:
#
#   cp apps/perception/.env.example ~/.c3po/perception.env
#
# NOT HERE: the ROS/DDS domain. Perception's /c3po/* topics live on domain 42,
# fixed in the images (nav/Dockerfile, vision/Dockerfile, bringup/spec.py,
# config/cyclonedds-domain42.xml) and matched by the bridge's own
# `PERCEPTION_DOMAIN_ID=42` (apps/bridge/.env.example). It is not configurable
# from this file.

# --- which model (vision container, and the engine build_perception makes) ---
# The three move together: the labels must come from the checkpoint the ONNX was
# exported from, and the engine is built from that ONNX. Paths inside the
# container; ~/.c3po/models is mounted at /opt/c3po/models.
# C3PO_ONNX=/opt/c3po/models/yolo11n.onnx
# C3PO_ENGINE=/opt/c3po/engines/yolo11n.fp16.plan
# C3PO_LABELS=/opt/c3po/models/labels.txt

# --- detector tuning (vision/c3po_vision/detector.py) ---
# Confidence floor for every class, and the NMS overlap threshold.
# C3PO_VISION_CONF=0.35
# C3PO_VISION_IOU=0.45
# Per-class bars ABOVE C3PO_VISION_CONF, or `off`: "cooker=0.6,thumbtack=off".
# `person` is refused (the bridge's person rule reads it). Empty = none.
# C3PO_VISION_CLASS_CONF=
# Detector ticks per second.
# C3PO_VISION_HZ=10
# Most objects sent per frame; the rest are counted as omitted.
# C3PO_VISION_MAX_OBJECTS=32
# How much farther than the surface under it an object may read before its depth
# is distrusted and the support plane is used. <= 0 turns that fallback off.
# C3PO_VISION_BEHIND_M=0.30
# The surface each nearby object stands on, for the arm planner. 0 = off.
# C3PO_VISION_SUPPORT=1

# --- the /live-camera MJPEG on :8081 ---
# Frames per second (perception_up passes 10 when unset).
# C3PO_VISION_STREAM_HZ=10

# --- the head camera mount (pelvis frame) ---
# All unset = the URDF's CAD mount. Measured values come from
# apps/bridge/scripts/camera_calibrate.py, and go in apps/bridge/.env too: the
# bridge's arm uses the same five.
# C3PO_CAMERA_X_M=
# C3PO_CAMERA_Y_M=
# C3PO_CAMERA_Z_M=
# C3PO_CAMERA_PITCH_DEG=
# C3PO_CAMERA_YAW_DEG=

# --- the LiDAR ---
# republish: Nav2 reads the vendor's rt/utlidar republish (the default).
# driver: our own livox_ros_driver2 claims the Mid-360 itself (perception_up warns).
# C3PO_LIDAR_SOURCE=republish
