{
  "name": "@repo/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001 --host 127.0.0.1",
    "dev:robot": "PUBLIC_ROBOT_CAM_URL=${PUBLIC_ROBOT_CAM_URL:-http://localhost:8001/camera} PUBLIC_TELEOP_HOST=${C3PO_ROBOT_HOST:-localhost} vite dev --port 3001 --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun test",
    "start": "vite preview --port 3001",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
