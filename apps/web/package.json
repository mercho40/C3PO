    "@shikijs/themes": "^4.6.0",
    "ai": "^7.0.179",
    "better-auth": "^1.7.27",
    "dompurify": "^3.5.0",
    "elysia": "^1.4.32",
    "runed": "^0.38.0",
    "shiki": "^4.6.0",
    "svelte-exmarkdown": "^5.0.2",
