    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/webxr": "^0.5.24",
    "@typescript/native": "npm:typescript@7",
    "bits-ui": "^2.22.0",
    "clsx": "^2.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@ai-sdk/svelte": "^5.0.179",
    "@elysiajs/eden": "^1.4.9",
