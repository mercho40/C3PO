    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/webxr": "^0.5.24",
    "@typescript/native": "npm:typescript@7",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
