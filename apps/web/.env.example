PUBLIC_API_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-secret-here

# Optional. Host of the sim's teleimager camera servers (ports 60001-60003) for
# /live-camera. Defaults to the host serving the console (correct when the
# browser runs on the sim box). Set only to point at a different IP/hostname.
PUBLIC_SIM_CAM_HOST=

# Optional. Host/port of the real G1's camera relay (apps/bridge/src/bridge/
# camera_relay.py) for /vr-control. Only reachable directly today -- same LAN
# as the Jetson, or an SSH tunnel forwarding the port (see that module's
# docstring). Defaults: host = the host serving the console, port = 8766.
PUBLIC_REAL_CAM_HOST=
PUBLIC_REAL_CAM_PORT=

# Optional. Host/port of the real G1's teleop stream (apps/bridge/src/bridge/
# teleop/server.py) for /vr-control's arm mirror. Same "no auth of its own,
# tunnel it" posture as the camera relay above: this socket carries live
# setpoints for the robot's arms and is loopback-bound on the Jetson.
# Defaults: host = the host serving the console, port = 8767.
PUBLIC_TELEOP_HOST=
PUBLIC_TELEOP_PORT=
