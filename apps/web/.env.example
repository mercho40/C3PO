PUBLIC_API_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-secret-here

# --- /live-camera. Two sources, and setting the robot one wins. --------------
#
# The simulator and the real G1 do not serve video the same way, so the page has
# two clients and picks by which of these is set. PUBLIC_ROBOT_CAM_URL takes
# precedence: a console attached to a physical robot must not show a simulation.

# Optional. Host of the sim's teleimager camera servers (ports 60001-60003) for
# /live-camera. Defaults to the host serving the console (correct when the
# browser runs on the sim box). Set only to point at a different IP/hostname.
PUBLIC_SIM_CAM_HOST=

# Optional. Base URL of the REAL robot's camera feed. No trailing path — the
# page appends /stream.mjpg and /status itself.
#
# ONE URL, WHICHEVER FEED IS ALIVE. There are two servers for the one physical
# camera and they are mutually exclusive, because /dev/video4 has a single
# owner: the vendor's videohub RPC (1920x1080, no device claim) and
# apps/perception's vision container on :8081 (640x480, owns the device, and
# the object detector comes with it). Which one is live flips whenever somebody
# runs `take_camera` or hands the sensors back.
#
# The BRIDGE picks, and relays :8081 when the vendor feed is dark
# (bridge/sdk/camera_relay.py). So this value does not change when the camera
# changes hands. The browser reaches the bridge directly by mDNS:
#
# `/camera/status` names the serving source and reports BOTH, so a dark feed
# says which server was asked and what it answered.
#
# Point it straight at http://g1-orin.local:8081 only to bypass
# the bridge — worth knowing for debugging, not the normal setup.
# Shipped SET, not blank: the page skips the camera entirely when this is
# empty, and a .env regenerated from this file would silently lose it.
PUBLIC_ROBOT_CAM_URL=http://g1-orin.local:8001/camera

# Optional. Host/port of the real G1's teleop stream (apps/bridge/src/bridge/
# teleop/server.py) for /vr-control's arm mirror. This socket carries live
# setpoints and is directly reachable on the LAN while `c3po up teleop` runs.
# Defaults: host = the host serving the console, port = 8767.
PUBLIC_TELEOP_HOST=g1-orin.local
PUBLIC_TELEOP_PORT=
