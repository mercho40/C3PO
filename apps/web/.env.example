PUBLIC_API_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-secret-here

# --- /live-camera. Two sources, and setting the robot one wins. --------------
#
# The simulator and the real G1 do not serve video the same way, so the page has
# two clients and picks by which of these is set. PUBLIC_ROBOT_CAM_URL takes
# precedence: a console attached to a physical robot must not show a simulation.

# Optional. Host of the sim's teleimager camera servers (ports 60001-60003) for
# /live-camera. Defaults to the host serving the console (correct when the
# browser runs on the sim box). Set only to point at a different IP/hostname.
PUBLIC_SIM_CAM_HOST=

# Optional. Base URL of the REAL robot's camera feed. No trailing path — the
# page appends /stream.mjpg and /status itself, so any server with those two
# endpoints works. There are TWO on this robot and they are mutually exclusive,
# because `/dev/video4` has exactly one owner:
#
#   http://127.0.0.1:8001/camera   THE BRIDGE, via Unitree's videohub RPC.
#                                  1920x1080. Works WITHOUT owning the device —
#                                  it reads frames from the vendor service that
#                                  holds it. Needs no second forward: the tunnel
#                                  that carries the bridge already carries this.
#                                  Colour only; there is no depth in a JPEG.
#
#   http://127.0.0.1:8081          THE VISION CONTAINER, which owns the D435i.
#                                  Colour + depth, so this is the one the object
#                                  detector needs. Only answers while
#                                  `perception_up perception` (or `nav2`) runs,
#                                  and only after somebody freed the device with
#                                  `take_camera`. Needs `-L 8081` as well.
#
# Whichever is set, the tunnel:
#
#   ssh -f -N -o ControlMaster=no -L 8001:127.0.0.1:8001 -L 8081:127.0.0.1:8081 c3po
#
# The default is the videohub feed: it is the one that works without taking a
# camera away from anybody, which is the right default on a robot two teams
# share. `docs/ROBOT-HARDWARE.md` §6.6 has the measurements and the trade.
# Shipped SET, not blank: the page skips the camera entirely when this is
# empty, and a .env regenerated from this file would silently lose it.
PUBLIC_ROBOT_CAM_URL=http://127.0.0.1:8001/camera

# Optional. Host/port of the real G1's teleop stream (apps/bridge/src/bridge/
# teleop/server.py) for /vr-control's arm mirror. Same "no auth of its own,
# tunnel it" posture as the bridge itself: this socket carries live setpoints
# for the robot's arms and is loopback-bound on the Jetson.
# Defaults: host = the host serving the console, port = 8767.
PUBLIC_TELEOP_HOST=
PUBLIC_TELEOP_PORT=
