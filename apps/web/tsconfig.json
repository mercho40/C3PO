{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    "strict": true,
    // The generated base config pins "types", which suppresses auto-inclusion
    // of every other @types/* package -- without "webxr" here, its ambient
    // globals (XRSession, navigator.xr, ...) never load, even though the
    // package is installed.
    "types": ["$app/types", "node", "webxr"]
  },
  "include": ["src", "vite.config.ts", "tests"]
}
