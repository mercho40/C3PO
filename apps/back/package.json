    "ai": "^7.0.67",
    "ajv": "^8.20.0",
    "better-auth": "^1.5.5",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.28",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
