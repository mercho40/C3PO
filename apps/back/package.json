{
  "name": "@repo/back",
  "version": "1.0.50",
  "type": "module",
  "imports": {
    "#back/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "build": "bun build --compile --minify --target bun --outfile server src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "dev:robot": "BRIDGE_URL=${BRIDGE_URL:-http://127.0.0.1:8001/mcp} bun run --watch src/index.ts",
    "start": "./server",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:studio": "bunx drizzle-kit studio",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.68",
    "@elysiajs/cors": "^1.4.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@sinclair/typebox": "^0.34.52",
    "ai": "^7.0.140",
    "ajv": "^8.20.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "bun-types": "^1.4.3",
    "drizzle-kit": "^0.31.11",
    "postgres": "^3.4.9",
    "typescript": "~6.0.3"
  }
}
