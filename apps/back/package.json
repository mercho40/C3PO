{
  "name": "@repo/back",
  "version": "1.0.50",
  "type": "module",
  "imports": {
    "#back/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "build": "bun build --compile --minify --target bun --outfile server src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "dev:robot": "BRIDGE_URL=${BRIDGE_URL:-http://127.0.0.1:8001/mcp} bun run --watch src/index.ts",
    "start": "./server",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:studio": "bunx drizzle-kit studio",
    "check-types": "tsc --noEmit",
    "eval:t0": "bun scripts/eval-agent.ts --tier T0 --expect-env stub"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@elysiajs/cors": "^1.4.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sinclair/typebox": "^0.34.52",
    "ai": "^7.0.179",
    "ajv": "^8.20.0",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.32",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@types/ws": "^8.18.2",
    "bun-types": "^1.4.5",
    "drizzle-kit": "^0.31.11",
    "postgres": "^4.1.1",
    "typescript": "~6.0.3"
  }
}
