DATABASE_URL=postgresql://user:password@localhost:5432/m4
PORT=3000                     # Elysia listen port (defaults to 3000 if unset)
BETTER_AUTH_SECRET=           # min 32 chars: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
WEB_URL=http://localhost:3001
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# C3PO bridge MCP endpoint (FastMCP streamable-http). Launch the bridge with
# BRIDGE_TRANSPORT=http — see apps/bridge/README.md.
#
# The value below only works while `back` and the bridge share a host. Against
# the real robot the bridge runs onboard the G1 Jetson on port 8001 (8000 is
# taken by gemm-ai.service) and binds loopback, since it can command the legs
# and has no auth of its own — so reach it through an SSH tunnel, e.g.
#   ssh -N -L 8001:127.0.0.1:8001 unitree@g1-orin.local
# Address the robot by mDNS name, not IP — it is on DHCP and has moved twice.
#
# THE PORT DIFFERS BY TARGET, and the two are one character apart:
#   8000 — a locally-run bridge (`bun run serve:http` in apps/bridge, which
#          uses mcp_server.py's own default port). This is the value below.
#   8001 — the real robot over the SSH tunnel above. `apps/bridge/.env.example`
#          sets BRIDGE_PORT=8001 because gemm-ai.service holds 8000 onboard.
# Copying both .env.example files verbatim and then tunnelling to the robot
# gives a back that dials 8000 and a bridge listening on 8001 — which presents
# as "bridge_unavailable" with both processes visibly healthy. Switch this to
# 8001 whenever you point at real hardware.
BRIDGE_URL=http://127.0.0.1:8000/mcp

# Internal agent (POST /agent). The Vercel AI SDK Anthropic provider reads
# ANTHROPIC_API_KEY automatically. Model + step budget are optional overrides.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-4-8
AGENT_MAX_STEPS=12
# "adaptive" (default) lets the model decide when to think; AGENT_THINKING=off
# forces it off. Always off for Haiku regardless of this value.
AGENT_THINKING=adaptive
