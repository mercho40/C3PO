DATABASE_URL=postgresql://user:password@localhost:5432/m4
PORT=3000                     # Elysia listen port (defaults to 3000 if unset)
# Listen address. Loopback by default: nothing on the LAN needs :3000 (the
# console's Vite is local, the Quest uses adb reverse). Set it HERE, not in the
# shell (turbo strips shell env). 0.0.0.0 only on a LAN box behind TLS.
BACK_HOST=127.0.0.1
BETTER_AUTH_SECRET=           # min 32 chars: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
WEB_URL=http://localhost:3001
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# C3PO bridge MCP endpoint (FastMCP streamable-http). Launch the bridge with
# BRIDGE_TRANSPORT=http — see apps/bridge/README.md.
#
# The real bridge listens on the robot's LOOPBACK only (since 2026-09-06: /mcp
# can walk the robot and has no authentication of its own, so it must not sit
# open on the school Wi-Fi — scripts/robot/c3po-bridge.service). Reach it
# through a tunnel, addressed by mDNS name via the `c3po` ssh alias:
#
#   ssh -f -N -o ControlMaster=no -L 8001:127.0.0.1:8001 c3po
#
# Port 8000 belongs to gemm-ai.service; C3PO uses 8001. A bridge run locally
# (SIM_MODE=stub) is on whatever BRIDGE_PORT you gave it.
# Root `bun run dev:robot` uses this same tunnel URL unless BRIDGE_URL is set.
BRIDGE_URL=http://127.0.0.1:8001/mcp

# T2 confirmation (arm/hand skills). POST /skills/:name/confirm forwards this
# to the bridge's /safety/confirm; it must equal the bridge's own
# SAFETY_CONFIRM_SECRET. Empty = no confirmation can be given, so T2 skills
# stay refused (apps/bridge/src/bridge/safety.py). Any long random string.
SAFETY_CONFIRM_SECRET=

# Teleop socket token (GET /teleop/token, admins only). Must equal the bridge's
# own TELEOP_SECRET. Empty = no token is minted and the bridge, also without
# one, accepts the headset with a loud warning. Any long random string.
TELEOP_SECRET=

# Internal agent (POST /agent). Runs on TIC AI — ORT's OpenAI-compatible
# gateway in front of models hosted on campus (https://ia.ort.edu.ar — HTTPS ONLY, port 80 is blocked from the WiFi VLAN). There is
# no self-serve key issuance: ask Shulian for one.
#
# Gotchas worth keeping in this file rather than rediscovering:
#   - https, not http. Port 80 is administratively blocked from the campus
#     Wi-Fi VLAN while 443 answers — the opposite of what this line used to say
#     (src/agent/runtime.ts, commit 63c3149). Test both ports before calling the
#     host unreachable; the scheme lives here so it can flip without a code
#     change.
#   - The gateway is reachable from inside the ORT network only.
#   - Auth is `Authorization: Bearer <key>`; unauthenticated requests return
#     401 {"error":{"code":"missing_api_key"}}. CORS is open on /api/v1/*.
#   - Uptime is not a given. On 2026-08-18 the nginx front end answered 502
#     with an HTML body for an extended stretch; the SDK retries a 5xx twice,
#     so the operator sees "Failed after 3 attempts. Last error: Bad Gateway"
#     after ~6 s and the HTML never leaves APICallError.responseBody.
#
# AGENT_MODEL: tic-chat is the multimodal, tool-calling model the agent loop
# needs. The site also advertises tic-code and tic-embed, but GET /models
# returned only tic-chat and tic-test on 2026-08-18 — check the endpoint before
# depending on the other two. tic-test is the cheap one for wiring checks.
# Nothing in the code is TIC-specific: point these at any OpenAI-compatible
# server and the agent follows.
AGENT_BASE_URL=https://ia.ort.edu.ar/api/v1
AGENT_API_KEY=
AGENT_MODEL=tic-chat
# Speech-to-text for the headset's push-to-talk (POST /voice/transcribe), same gateway.
# Also the robot mic's utterances when the bridge runs with C3PO_STT=back (legacy loop).
AGENT_TRANSCRIBE_MODEL=tic-transcript
AGENT_MAX_STEPS=40
# Wall-clock budget per agent turn, seconds (default 240). The turn stops at
# whichever of the two comes first.
AGENT_TURN_BUDGET_S=240
# "adaptive" (default) lets the model decide when to think; AGENT_THINKING=off
# forces it off. Always off for Haiku regardless of this value.
AGENT_THINKING=adaptive
# The model the `look` tool sends camera frames to — same gateway and key as
# the agent. Empty means AGENT_MODEL: tic-chat reads images (verified
# 2026-10-27 on a real robot frame; re-check with scripts/smoke-vision.ts after
# any model change — a model that ignores images still answers fluently).
VISION_MODEL=

# Spoken conversation engine — the DEFAULT only. The operator picks the engine
# per session on the console's voice panel (POST /voice/start {engine}); this
# is what a start without a choice runs on. `legacy` keeps the local STT -> text
# model -> Piper path. `realtime` streams the robot's raw PCM through this
# backend to OpenAI, persists final transcripts in the same chat tables, and
# still dispatches every robot function through the bridge. The API key never
# reaches web or robot. Realtime is offered at all only when OPENAI_API_KEY is
# set; both are read once at boot, so adding a key needs a back restart.
VOICE_ENGINE=legacy
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# The headset's push-to-talk reply (POST /agent with mode "voice") is said out
# loud through the bridge's `say` (Spanish, Piper) once the turn completes.
# Off unless 1. An aborted turn, PARAR, or a typed chat says nothing.
HEADSET_SPEAK_REPLY=0

# Accounts granted role: "admin" at boot (comma-separated).
# Better Auth cannot create the first admin through the product -- signUp always
# writes a null role, and its own setRole endpoint is admin-gated. Without this
# the only path is hand-written SQL. See src/lib/admin-bootstrap.ts.
ADMIN_EMAILS=
