DATABASE_URL=postgresql://user:password@localhost:5432/m4
PORT=3000                     # Elysia listen port (defaults to 3000 if unset)
BETTER_AUTH_SECRET=           # min 32 chars: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
WEB_URL=http://localhost:3001
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# C3PO bridge MCP endpoint (FastMCP streamable-http). Launch the bridge with
# BRIDGE_TRANSPORT=http — see apps/bridge/README.md.
#
# The real bridge is directly reachable on the school LAN. Address the robot by
# mDNS name, not IP — its DHCP lease has moved twice. Port 8000 belongs to
# gemm-ai.service; C3PO uses 8001.
#
# Root `bun run dev` overrides this with the safe local stub on 127.0.0.1:8002.
# Root `bun run dev:robot` pins the direct URL below regardless of this file.
BRIDGE_URL=http://g1-orin.local:8001/mcp

# Internal agent (POST /agent). Runs on TIC AI — ORT's OpenAI-compatible
# gateway in front of models hosted on campus (http://ia.ort.edu.ar). There is
# no self-serve key issuance: ask Shulian for one.
#
# Gotchas worth keeping in this file rather than rediscovering:
#   - http, not https. The TIC AI site documents an https:// base URL, but the
#     host does not answer on 443. The scheme lives here so it can flip without
#     a code change the day TLS is turned on.
#   - The gateway is reachable from inside the ORT network only.
#   - Auth is `Authorization: Bearer <key>`; unauthenticated requests return
#     401 {"error":{"code":"missing_api_key"}}. CORS is open on /api/v1/*.
#   - Uptime is not a given. On 2026-08-18 the nginx front end answered 502
#     with an HTML body for an extended stretch; the SDK retries a 5xx twice,
#     so the operator sees "Failed after 3 attempts. Last error: Bad Gateway"
#     after ~6 s and the HTML never leaves APICallError.responseBody.
#
# AGENT_MODEL: tic-chat is the multimodal, tool-calling model the agent loop
# needs. The site also advertises tic-code and tic-embed, but GET /models
# returned only tic-chat and tic-test on 2026-08-18 — check the endpoint before
# depending on the other two. tic-test is the cheap one for wiring checks.
# Nothing in the code is TIC-specific: point these at any OpenAI-compatible
# server and the agent follows.
AGENT_BASE_URL=http://ia.ort.edu.ar/api/v1
AGENT_API_KEY=
AGENT_MODEL=tic-chat
AGENT_MAX_STEPS=12
# "adaptive" (default) lets the model decide when to think; AGENT_THINKING=off
# forces it off. Always off for Haiku regardless of this value.
AGENT_THINKING=adaptive

# Spoken conversation engine. `legacy` keeps the local STT -> text model -> Piper
# path. `realtime` streams the robot's raw PCM through this backend to OpenAI,
# persists final transcripts in the same chat tables, and still dispatches every
# robot function through the bridge. The API key never reaches web or robot.
VOICE_ENGINE=legacy
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Accounts granted role: "admin" at boot (comma-separated).
# Better Auth cannot create the first admin through the product -- signUp always
# writes a null role, and its own setRole endpoint is admin-gated. Without this
# the only path is hand-written SQL. See src/lib/admin-bootstrap.ts.
ADMIN_EMAILS=
