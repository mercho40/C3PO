{
  "name": "@repo/bridge",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "mcp": "uv run --project . python -m bridge.mcp_server",
    "serve:http": "BRIDGE_TRANSPORT=http SIM_MODE=stub uv run --project . python -m bridge.mcp_server",
    "teleop": "uv run --project . python -m bridge.teleop.server",
    "build": "uv sync && bash scripts/postsync.sh",
    "check-types": "uv run --project . mypy src scripts",
    "lint": "uv run --project . ruff check src tests",
    "test": "uv run --project . pytest"
  }
}
