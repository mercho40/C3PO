# Robot connection
SIM_MODE=stub                  # 'stub' | 'isaac' | 'real'
DDS_DOMAIN_ID=1                # unitree_sim_isaaclab uses domain 1; the real G1 uses 0
# Isaac Sim host IP. For SIM_MODE=real this is the G1's *control board*
# (192.168.123.161) — not the Jetson, which is where the bridge itself runs.
ROBOT_HOST=10.20.10.126

# Pin CycloneDDS to one NIC. Empty = autodetermine, which is correct on a dev
# machine. Onboard the G1's Jetson set this to eth0: that host also has wlan0
# and docker0, CycloneDDS picks among them arbitrarily, and only eth0 reaches
# the control board. See docs/ROBOT-INVENTORY.md §2.
DDS_INTERFACE=

# CycloneDDS C library install prefix (required at runtime — Python bindings dlopen libddsc.dylib).
# See apps/bridge/README.md for build instructions on macOS.
CYCLONEDDS_HOME=/Users/your-username/.local/cyclonedds-0.10.2

# Voice (Phase 4 — not used yet)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
WAKE_WORD_MODEL=hey_claude.tflite

# Logging
LOG_LEVEL=info
