# Robot connection
SIM_MODE=stub                  # 'stub' | 'isaac' | 'mujoco_local' | 'real'
DDS_DOMAIN_ID=1                # unitree_sim_isaaclab uses domain 1; the real G1 uses 0
# Isaac Sim host IP. For SIM_MODE=real this is the G1's *control board*
# (192.168.123.161) — not the Jetson, which is where the bridge itself runs.
ROBOT_HOST=10.20.10.126

# Pin CycloneDDS to one NIC. Empty = autodetermine, which is correct on a dev
# machine. Onboard the G1's Jetson set this to eth0: that host also has wlan0
# and docker0, CycloneDDS picks among them arbitrarily, and only eth0 reaches
# the control board. See docs/ROBOT-HARDWARE.md §2.
# NOTE: currently logged but NOT applied — the vendor SDK's inline config
# overrides CYCLONEDDS_URI (pending fix: docs/ROBOT-API.md, known divergences).
DDS_INTERFACE=

# CycloneDDS C library install prefix (required at runtime — Python bindings dlopen libddsc.dylib).
# macOS: build from source, see apps/bridge/README.md (no Homebrew formula).
# Jetson: /home/unitree/cyclonedds_ws/install/cyclonedds — prebuilt 0.10.2
# already on the box, no source build needed (docs/ROBOT-HARDWARE.md §2).
CYCLONEDDS_HOME=/Users/your-username/.local/cyclonedds-0.10.2

# MCP transport. Default is stdio, which is right when an MCP client (Claude
# Code, via .mcp.json) launches the bridge as a child process and talks over
# pipes. Set http to run it as a long-lived daemon that `apps/back` connects to
# — a daemon on stdio gets /dev/null for stdin, reads EOF and exits at once.
# `c3po-bridge.service` pins HTTP on a direct LAN bind; set these only for
# direct developer runs.
#
# Port: 8001 onboard the G1, because gemm-ai.service holds 8000 there. The unit
# overrides BRIDGE_HOST to 0.0.0.0; the module default remains loopback so an
# ad-hoc developer run does not expose itself accidentally.
BRIDGE_TRANSPORT=
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8001
BRIDGE_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Operator-link watchdog (real hardware only; docs/ARCHITECTURE.md §7). OFF by
# default and deliberately so while tool calls block — set 'on' / '1' / 'true'
# to arm. LINK_TIMEOUT_MS is the silence threshold before it acts (stops, never
# damps, and only when something is moving).
LINK_WATCHDOG=
LINK_TIMEOUT_MS=1500

# DDS domain the bridge joins to hear the perception container (its /c3po/*
# topics live on their own domain, isolated from the robot's domain 0).
PERCEPTION_DOMAIN_ID=42

# Where landmark memory persists (default: ~/.c3po/landmarks.json).
LANDMARKS_PATH=

# Voice (Phase 4 — not used yet)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
WAKE_WORD_MODEL=hey_claude.tflite

# Logging
LOG_LEVEL=info
