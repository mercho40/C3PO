{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".svelte-kit/**", "build/**", "server", ".vercel/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:robot": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["C3PO_ROBOT_HOST"]
    },
    "start": {
      "dependsOn": ["build"],
      "persistent": true
    }
  }
}
