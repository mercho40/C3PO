{
  "mcpServers": {
    "c3po-sim": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "apps/bridge",
        "python",
        "-m",
        "bridge.mcp_server"
      ],
      "env": {
        "BRIDGE_TRANSPORT": "stdio",
        "SIM_MODE": "isaac",
        "DDS_DOMAIN_ID": "1",
        "ROBOT_HOST": "10.20.10.126",
        "CYCLONEDDS_HOME": "/Users/your-username/.local/cyclonedds-0.10.2"
      }
    },
    "c3po-bridge": {
      "type": "http",
      "url": "http://127.0.0.1:8001/mcp"
    }
  }
}
